        </mxCell>
        <mxCell id="p6_p6_data_fields" value="&lt;b&gt;Data buses • payload bits + sidebands&lt;/b&gt;&lt;br&gt;&lt;br&gt;TileSignal: tile (Line128), valid&lt;br&gt;ResultSignal: tile (Line128), valid,&lt;br&gt;neurons, batch&lt;br&gt;&lt;br&gt;AccSignal: tile (TileSums), config (Line128),&lt;br&gt;valid, neurons, batch&lt;br&gt;→ 512 sum bits + 128 CFG bits + qualifiers&lt;br&gt;&lt;br&gt;StreamStatus: input_valid, output_ready&lt;br&gt;&lt;br&gt;Line128: lane[4] (uint32_t)&lt;br&gt;TileSums: value[4][4] (int32_t)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=14;fontSize=16;" vertex="1" parent="p6_1">
          <mxGeometry x="855" y="2034" width="765" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p6_p6_phase_fields" value="&lt;b&gt;One simulated cycle • framework_step()&lt;/b&gt;&lt;br&gt;&lt;br&gt;PUBLISH: SRAM response + stream signals&lt;br&gt;EVAL: controller → MAC → activation → scale&lt;br&gt;CHECK: all transfers and numerical checks&lt;br&gt;CLOCK: each block updates its own registers&lt;br&gt;&lt;br&gt;Registration order: controller, sram, stream,&lt;br&gt;mac, activation, scale&lt;br&gt;&lt;br&gt;Internal regs are not buses. C unsigned fields&lt;br&gt;are not fixed-width RTL declarations.&lt;br&gt;Dashed wires = controls/status; solid = data." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=14;fontSize=16;" vertex="1" parent="p6_1">
          <mxGeometry x="1650" y="2034" width="790" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p6_p6_source_note" value="&lt;b&gt;Scope:&lt;/b&gt; port names and connections verified against the supplied c-model.zip. SRAM capacity uses the agreed 1 MiB revision; the saved source still has the earlier constants.&lt;br&gt;Future SoC slave interface / IRQ / MMIO are not implemented here. This page describes the C netlist, not a synthesized RTL pinout." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=14;fontSize=15;" vertex="1" parent="p6_1">
          <mxGeometry x="60" y="2384" width="2380" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
