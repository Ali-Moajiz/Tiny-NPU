        <mxCell id="p4_use7" parent="p4_1" vertex="1" value="Stream ports, not an SRAM/MMIO window. STREAM_LOAD writes one 16-byte beat into the activation region." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="395" y="998" width="1345" height="56" as="geometry" />
        </mxCell>
