          <mxGeometry x="60" y="1057" width="335" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4_use8" parent="p4_1" vertex="1" value="STREAM_STORE reads an activation-region beat. output_push accepts it when output_ready is true." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="395" y="1057" width="1345" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4_ref_note" parent="p4_1" vertex="1" value="&lt;b&gt;Address conventions and source alignment&lt;/b&gt;&lt;br&gt;One 1 MiB SRAM macro, 65,536 words × 16 bytes. Aligned byte address → word index address[19:4]. All instruction address fields remain 32 bits.&lt;br&gt;This page applies the agreed 1 MiB map. Port/register names are checked against the supplied c-model.zip; that saved source still has the earlier capacity constants.&lt;br&gt;The SoC slave is a future integration label. Do not interpret C struct fields or host stream buffers as implemented MMIO peripherals." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;fillColor=#F1F5FF;align=left;">
          <mxGeometry x="60" y="1150" width="1680" height="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
