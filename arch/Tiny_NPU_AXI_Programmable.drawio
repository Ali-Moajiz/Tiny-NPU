  <diagram id="axi-ip-isa" name="02 — ISA and controller contract">
    <mxGraphModel dx="2240" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1320" background="#FFFFFF" math="0" shadow="0">
