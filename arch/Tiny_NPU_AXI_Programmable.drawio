        <mxCell id="p6_p6_control_fields" value="&lt;b&gt;Control • controller output&lt;/b&gt;&lt;br&gt;&lt;br&gt;bool: rd_en, read_consume, wr_en,&lt;br&gt;latch_en, compute_en, accumulate,&lt;br&gt;post_en, forward_en, input_pop, output_push&lt;br&gt;&lt;br&gt;uint32_t: rd_addr, wr_addr, pc&lt;br&gt;uint16_t: byte_enable&lt;br&gt;WriteSource: write_source&lt;br&gt;&lt;br&gt;unsigned: latch_slot, latch_field, slot, k,&lt;br&gt;k_count, neurons, batch, forward_slot" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=14;fontSize=16;" vertex="1" parent="p6_1">
