        <mxCell id="p4_info4" parent="p4_1" vertex="1" value="Activation has ports only (combinational). ScaleClamp has regs.result {tile, valid, neurons, batch}; POST_LATENCY selects 0 or 1 clock output timing." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
