        <mxCell id="p2_1" parent="p2_0" />
        <mxCell id="p2_isa_title" value="&lt;b&gt;128-bit ISA • programmable controller&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#111111;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontSize=25;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="30" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_field0" value="&lt;b&gt;[127:124] • 4 bits&lt;/b&gt;&lt;br&gt;Opcode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="125" width="160" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_field1" value="&lt;b&gt;[123:92] • 32 bits&lt;/b&gt;&lt;br&gt;SRAM source byte address / loop count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="220" y="125" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_field2" value="&lt;b&gt;[91:60] • 32 bits&lt;/b&gt;&lt;br&gt;Destination byte address / slot-field / loop target" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="600" y="125" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_field3" value="&lt;b&gt;[59:32] • 28 bits&lt;/b&gt;&lt;br&gt;N[3:0], batch[7:4], K[11:8]&lt;br&gt;Load/store: dims = 16 bytes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="980" y="125" width="350" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_field4" value="&lt;b&gt;[31:0] • 32 bits&lt;/b&gt;&lt;br&gt;EXEC: slot bit 0 / retain bit 1&lt;br&gt;POST: slot bit 0 / store bit 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="1330" y="125" width="350" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_ophead" value="&lt;b&gt;Opcode&lt;/b&gt;                       &lt;b&gt;Operation&lt;/b&gt;                                   &lt;b&gt;Effect / operands&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="250" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_op0" value="&lt;b&gt;0x1  OP_STREAM_LOAD&lt;/b&gt;&lt;br&gt;One runtime input beat → SRAM[DEST]. SRC=0, dims=16, flags=0. Wait for input_valid; assert input_pop with the write." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="300" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_op1" value="&lt;b&gt;0x2  OP_EXEC_MAC&lt;/b&gt;&lt;br&gt;Update N × batch independent PEs for K clocks. Slot = flags[0]; accumulate = flags[1]. Missing operands are a model fault." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="372" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_op2" value="&lt;b&gt;0x3  OP_POST_PROC&lt;/b&gt;&lt;br&gt;Completed sums → ReLU/bypass → scale/round/clamp. Optional store uses DEST; 1 + POST_LATENCY dispatch clocks." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="444" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_op3" value="&lt;b&gt;0x4  OP_FORWARD&lt;/b&gt;&lt;br&gt;Completed result → X of slot DEST (0 or 1). Matching N / batch required. SRC=0, flags=0; no SRAM access." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="516" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_op4" value="&lt;b&gt;0x5  OP_STREAM_STORE&lt;/b&gt;&lt;br&gt;Read one beat from SRAM[SRC] → runtime output. DEST=0, dims=16, flags=0. Hold response until output_ready." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="588" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_op5" value="&lt;b&gt;0x6  OP_LOOP_START&lt;/b&gt;&lt;br&gt;SRC = positive loop count; DEST = PC + 16. One non-nested loop context; dims=0, flags=0." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="660" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_op6" value="&lt;b&gt;0x7  OP_LOOP_END&lt;/b&gt;&lt;br&gt;DEST must match active loop body. Decrement count; branch while nonzero. SRC=0, dims=0, flags=0." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="732" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_op7" value="&lt;b&gt;0xF  OP_HALT&lt;/b&gt;&lt;br&gt;Set controller.regs.done at retirement; all other fields zero. HALT inside an active loop faults. No implemented IRQ signal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;align=left;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="804" width="1620" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p2_s0" value="&lt;b&gt;CTRL_FETCH → CTRL_RESPONSE&lt;/b&gt;&lt;br&gt;Request SRAM[pc]; capture regs.ir&lt;br&gt;Two cycles at normal read latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="965" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_s1" value="&lt;b&gt;CTRL_DECODE&lt;/b&gt;&lt;br&gt;instruction_decode(ir)&lt;br&gt;handlers[opcode] → validate()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="490" y="965" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_s2" value="&lt;b&gt;CTRL_DISPATCH&lt;/b&gt;&lt;br&gt;active_handler-&gt;execute()&lt;br&gt;PROGRESS / WAIT / DONE / FAULT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="920" y="965" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_s3" value="&lt;b&gt;CTRL_UPDATE&lt;/b&gt;&lt;br&gt;Optional retire() callback&lt;br&gt;PC + 16 / loop branch / done" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="1350" y="965" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_state0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="p2_1" source="p2_s0" target="p2_s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_state1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="p2_1" source="p2_s1" target="p2_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_state2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="p2_1" source="p2_s2" target="p2_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_loopstate" value="next instruction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=1;strokeWidth=2;" edge="1" parent="p2_1" source="p2_s3" target="p2_s0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1515" y="1090" />
              <mxPoint x="225" y="1090" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_isa_notes" value="&lt;b&gt;Execution conventions • callbacks in instructions.c&lt;/b&gt;&lt;br&gt;Each instruction adds four lifecycle clocks: fetch, response, decode, update. Dispatch: LOAD_OPERAND=2; EXEC_MAC=K; POST_PROC=1+POST_LATENCY; STREAM_STORE=2; others=1 (without stalls).&lt;br&gt;At k=0, accumulate=false seeds bias; accumulate=true retains a live tile. Apply POST only after the full reduction.&lt;br&gt;Extra waiting increments bus_stall_cycles. Instructions execute sequentially; two operand slots alone do not create overlap.&lt;br&gt;The opcode registry and file I/O are C-model mechanisms. RTL needs an equivalent static decoder and physical interfaces." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;" vertex="1" parent="p2_1">
          <mxGeometry x="60" y="1140" width="1620" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p2_op_load" parent="p2_1" vertex="1" value="&lt;b&gt;0x8  OP_LOAD_OPERAND&lt;/b&gt;&lt;br&gt;One SRAM beat → MAC slot. SRC = aligned byte address; DEST = (slot &lt;&lt; 2) | field. X=0, W=1, B=2, CFG=3; dims=16, flags=0." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="60" y="876" width="1620" height="66" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="axi-ip-compiler" name="03 — Compiler and execution flow">
    <mxGraphModel dx="2240" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="p3_0" />
        <mxCell id="p3_1" parent="p3_0" />
        <mxCell id="p3_compiler_title" value="&lt;b&gt;Compiler pipeline and runtime scheduling&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#111111;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;fontSize=25;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="30" width="1620" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_model" value="&lt;b&gt;PyTorch / ONNX model&lt;/b&gt;&lt;br&gt;Graph, tensors, calibration data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="135" width="390" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_parse" value="&lt;b&gt;A • Graph parser + quantization&lt;/b&gt;&lt;br&gt;INT8 operands / INT32 accumulator-unit bias&lt;br&gt;Float model: representative calibration&lt;br&gt;Compatible Q/DQ model: imported quantization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="320" width="390" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p3_tile" value="&lt;b&gt;B • Tiling and memory layout&lt;/b&gt;&lt;br&gt;Map ≤ 4 neurons × ≤ 4 independent vectors&lt;br&gt;Split reduction into k-steps&lt;br&gt;Assign non-overlapping regions in shared SRAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="620" y="320" width="490" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p3_emit" value="&lt;b&gt;C • Instruction stream emitter&lt;/b&gt;&lt;br&gt;Assign byte addresses in the 1 MiB map&lt;br&gt;Emit dependency-ordered tile operations&lt;br&gt;Encode instructions as 128-bit words" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="1280" y="320" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p3_binary" value="&lt;b&gt;program.bin / program.hex&lt;/b&gt;&lt;br&gt;Instruction words only&lt;br&gt;Image location: byte address 0xF1000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="1150" y="640" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_blob" value="&lt;b&gt;Weight / bias / configuration&lt;/b&gt;&lt;br&gt;Compiler packs tiles and M / S / ReLU&lt;br&gt;Included in the complete sram.bin / sram.hex" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="620" y="640" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_runtime" value="&lt;b&gt;Runtime features&lt;/b&gt;&lt;br&gt;TB / host supplies quantized INT8 beats&lt;br&gt;Stream endpoint → STREAM_LOAD → SRAM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="640" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3_sequence" value="&lt;b&gt;Dependency-ordered execution&lt;/b&gt;&lt;br&gt;&lt;br&gt;OP_STREAM_LOAD • input beat → SRAM&lt;br&gt;OP_LOAD_OPERAND • B / CFG / W / X → selected slot&lt;br&gt;OP_EXEC_MAC • K compute edges; seed bias or retain sums&lt;br&gt;… load more W / X and EXEC_MAC with accumulate=true …&lt;br&gt;OP_POST_PROC • only after the final reduction tile&lt;br&gt;OP_FORWARD • optional completed result → next slot.X&lt;br&gt;… next layer compute …&lt;br&gt;OP_STREAM_STORE • SRAM result → runtime output&lt;br&gt;OP_HALT • set done at retirement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;" vertex="1" parent="p3_1">
          <mxGeometry x="620" y="900" width="1060" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p3_ownership" value="&lt;b&gt;Scheduling contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;One shared SRAM access per edge.&lt;br&gt;Each instruction is fetched from SRAM.&lt;br&gt;Callbacks emit control; operand data bypasses the controller.&lt;br&gt;Loaded flags qualify operands; missing operands fault.&lt;br&gt;Preserve partial sums across reduction tiles.&lt;br&gt;Forward a complete supported hidden tile or store to SRAM.&lt;br&gt;No automatic load/compute overlap in this model." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="900" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p3_m_parse" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="p3_1" source="p3_model" target="p3_parse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_parse_tile" value="quantized graph" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="p3_1" source="p3_parse" target="p3_tile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_tile_emit" value="tile schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="p3_1" source="p3_tile" target="p3_emit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_tile_blob" value="static model data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="p3_1" source="p3_tile" target="p3_blob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_emit_bin" value="128-bit words" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="p3_1" source="p3_emit" target="p3_binary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_bin_run" value="controller program" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.7;entryY=0;strokeWidth=2;" edge="1" parent="p3_1" source="p3_binary" target="p3_sequence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_runtime_seq" value="dynamic input tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0.15;entryY=0;strokeWidth=2;" edge="1" parent="p3_1" source="p3_runtime" target="p3_sequence">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="695" />
              <mxPoint x="500" y="840" />
              <mxPoint x="770" y="840" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_compile_note" value="&lt;b&gt;Image loading&lt;/b&gt;&lt;br&gt;sram.bin is exactly 1 MiB. sram.hex contains 65,536 data words; each 32-digit line represents one 128-bit SRAM word.&lt;br&gt;sram_load_hex() preloads the memory array before cycles begin. Runtime inputs arrive separately. The SoC slave interface remains a future boundary label." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;spacing=10;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="1260" width="1620" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="regs_map" name="04 — Registers and address map">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="1350" grid="1">
      <root>
        <mxCell id="p4_0" />
        <mxCell id="p4_1" parent="p4_0" />
        <mxCell id="p4_ref_title" parent="p4_1" vertex="1" value="&lt;b&gt;Block registers and 1 MiB SRAM address map&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;fontSize=24;align=left;">
          <mxGeometry x="60" y="30" width="1650" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p4_reg0" parent="p4_1" vertex="1" value="&lt;b&gt;Controller&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="60" y="105" width="335" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_info0" parent="p4_1" vertex="1" value="regs.pc / next_pc, ir, instruction, state, step; loop_active / loop_remaining / loop_pc; done. handlers[16] selects an InstructionHandler callback." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="395" y="105" width="1345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_reg1" parent="p4_1" vertex="1" value="&lt;b&gt;SRAM interface&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="60" y="167" width="335" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_info1" parent="p4_1" vertex="1" value="regs.memory[SRAM_LINES] and regs.response {tile, valid}. rd_addr / wr_addr are 32-bit byte addresses; physical index [19:4]. Response held until read_consume." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="395" y="167" width="1345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_reg2" parent="p4_1" vertex="1" value="&lt;b&gt;MAC operand storage&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="60" y="229" width="335" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_info2" parent="p4_1" vertex="1" value="regs.slot[2].operand[4] and loaded[4]. Fields X / W / B / CFG are each 128 bits. Two slots = 128 payload bytes; no autonomous background loading." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="395" y="229" width="1345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_reg3" parent="p4_1" vertex="1" value="&lt;b&gt;MAC execution&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
          <mxGeometry x="60" y="291" width="335" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_info3" parent="p4_1" vertex="1" value="regs.accumulators.value[4][4] (16 × INT32), valid, complete, neurons, batch, next_k. compute_cycles and useful_macs are 64-bit counters." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;strokeColor=#333333;fillColor=#FFFFFF;spacing=5;align=left;">
