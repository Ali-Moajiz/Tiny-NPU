        <mxCell id="p5_xtappe3_3" source="p5_ct3_3" target="p5_pe3_3" edge="1" parent="p5_1" style="edgeStyle=none;html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#333333;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_pe_detail" value="&lt;b&gt;One PE: mac.regs.accumulators.value[2][1]&lt;/b&gt;&lt;br&gt;&lt;br&gt;Owns neuron 2 for independent vector 1.&lt;br&gt;&lt;br&gt;At local k=0 and accumulate=false, start from B[2]. Otherwise use this PE’s retained accumulator.&lt;br&gt;&lt;br&gt;Every enabled edge adds W[2,k] × X[1,k]. K is 1..4 per EXEC_MAC; further reduction tiles retain sums.&lt;br&gt;&lt;br&gt;Only the completed dot product goes through activation and scale/clamp." parent="p5_1" vertex="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1170" y="240" width="515" height="335" as="geometry" />
        </mxCell>
        <mxCell id="p5_slots" value="&lt;b&gt;Operand storage inside Mac&lt;/b&gt;&lt;br&gt;&lt;br&gt;regs.slot[slot].operand[field]: X=0, W=1, B=2, CFG=3; loaded[field] qualifies each 128-bit field.&lt;br&gt;&lt;br&gt;X byte = 4*v+k; W byte = 4*r+k. All active PEs use the same k. Enable only r&amp;lt;neurons and v&amp;lt;batch." parent="p5_1" vertex="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="1170" y="603" width="515" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p5_legend" value="&lt;b&gt;Reading the wires&lt;/b&gt;&lt;br&gt;Horizontal trunks broadcast W; vertical trunks broadcast X. Dots are branch points; undotted crossings are separate nets.&lt;br&gt;At N=4 and batch=4, all 16 accumulators update on each compute edge. AccSignal carries 16 × INT32 sums plus CFG and qualifiers." parent="p5_1" vertex="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontFamily=Helvetica;fontSize=15;fillColor=#F1F5FF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=16;">
          <mxGeometry x="45" y="868" width="1640" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
